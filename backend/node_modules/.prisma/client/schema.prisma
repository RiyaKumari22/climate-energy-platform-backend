generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

enum Domain {
  CLIMATE
  ENERGY
  POWER
}

enum DataType {
  LATLONG
  STATE
  TIMESERIES
}

enum ChartType {
  MAP
  HEATMAP
  LINE
  BAR
  AREA
}

enum DatasetStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(ADMIN)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  uploadedDatasets Dataset[] @relation("UploadedBy")
  approvedDatasets Dataset[] @relation("ApprovedBy")
}

model Dataset {
  id          Int           @id @default(autoincrement())
  title       String
  domain      Domain
  dataType    DataType
  chartType   ChartType
  description String?
  status      DatasetStatus @default(PENDING)

  uploadedById Int
  approvedById Int?

  uploadedBy User  @relation("UploadedBy", fields: [uploadedById], references: [id])
  approvedBy User? @relation("ApprovedBy", fields: [approvedById], references: [id])

  records DatasetRecord[]

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model DatasetRecord {
  id        Int      @id @default(autoincrement())
  datasetId Int
  data      Json
  createdAt DateTime @default(now())

  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
}
